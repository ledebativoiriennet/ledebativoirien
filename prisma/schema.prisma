generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                @id @default(cuid())
  name                String?
  email               String?               @unique
  password            String?
  role                String                @default("USER")
  resetToken          String?
  resetTokenExpiry    DateTime?
  points              Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  companyId           String?
  lastLoginAt         DateTime?
  badges              String?               @db.Text
  emailVerified       DateTime?
  argumentVotes       ArgumentVote[]
  articleLikes        ArticleLike[]
  articlePurchases    ArticlePurchase[]
  authorSubscriptions AuthorSubscriber[]    @relation("UserAuthorSubs")
  bookmarks           Bookmark[]
  comments            Comment[]
  debateArguments     DebateArgument[]
  giftLinks           GiftLink[]
  highlights          Highlight[]
  newsletterSub       NewsletterSubscriber?
  purchases           Purchase[]
  pushSubscriptions   PushSubscription[]
  quizAttempts        QuizAttempt[]
  readingHistory      ReadingHistory[]
  subscriptions       Subscription[]
  tagSubscriptions    TagSubscriber[]
  company             Company?              @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "User_companyId_fkey")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String
  plan          String    @default("PREMIUM")
  status        String    @default("ACTIVE")
  startDate     DateTime  @default(now())
  endDate       DateTime?
  transactionId String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([userId], map: "Subscription_userId_fkey")
}

model Author {
  id          String             @id @default(cuid())
  wpId        Int?               @unique
  name        String
  slug        String             @unique
  email       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  articles    Article[]
  subscribers AuthorSubscriber[]
}

model Category {
  id        String     @id @default(cuid())
  wpId      Int?       @unique
  name      String
  slug      String     @unique
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  articles  Article[]  @relation("ArticleToCategory")

  @@index([parentId], map: "Category_parentId_fkey")
}

model Article {
  id                String            @id @default(cuid())
  wpId              Int?              @unique
  title             String            @db.VarChar(1000)
  slug              String            @unique @db.VarChar(1000)
  content           String            @db.LongText
  excerpt           String?           @db.Text
  imageUrl          String?           @db.VarChar(2000)
  imageCaption      String?           @db.VarChar(1000)
  isPremium         Boolean           @default(false)
  isConfidentiel    Boolean           @default(false)
  isFeatured        Boolean           @default(false)
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  authorId          String?
  videoUrl          String?           @db.VarChar(2000)
  videoFile         String?           @db.VarChar(2000)
  videoCaption      String?
  seoTitle          String?           @db.VarChar(500)
  seoDescription    String?           @db.Text
  isAudioAvailable  Boolean           @default(false)
  isLiveBlog        Boolean           @default(false)
  aiSummary         String?           @db.Text
  audioUrl          String?           @db.VarChar(2000)
  region            String?
  isFactCheck       Boolean           @default(false)
  factVerdict       String?
  timelineId        String?
  timelineEventDate DateTime?
  author            Author?           @relation(fields: [authorId], references: [id])
  likes             ArticleLike[]
  articlePurchases  ArticlePurchase[]
  quiz              ArticleQuiz?
  views             ArticleView[]
  bookmarks         Bookmark[]
  comments          Comment[]
  debate            Debate?
  giftLinks         GiftLink[]
  highlights        Highlight[]
  liveUpdates       LiveUpdate[]
  polls             Poll[]
  readingHistory    ReadingHistory[]
  categories        Category[]        @relation("ArticleToCategory")
  tags              Tag[]             @relation("ArticleToTag")
  Article_A         Article[]         @relation("RelatedArticles")
  Article_B         Article[]         @relation("RelatedArticles")

  @@index([publishedAt(sort: Desc)])
  @@index([isConfidentiel])
  @@index([isAudioAvailable])
  @@index([authorId])
}

model Poll {
  id        String       @id @default(cuid())
  question  String       @db.Text
  isActive  Boolean      @default(true)
  articleId String?
  createdAt DateTime     @default(now())
  article   Article?     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  options   PollOption[]

  @@index([articleId], map: "Poll_articleId_fkey")
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  text   String
  votes  Int    @default(0)
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId], map: "PollOption_pollId_fkey")
}

model Obituary {
  id        String   @id @default(cuid())
  name      String
  details   String   @db.Text
  imageUrl  String?  @db.VarChar(2000)
  createdAt DateTime @default(now())
}

model PressRelease {
  id        String   @id @default(cuid())
  title     String
  company   String
  createdAt DateTime @default(now())
  url       String?  @db.VarChar(2000)
}

model Video {
  id        String   @id @default(cuid())
  title     String
  youtubeId String
  createdAt DateTime @default(now())
}

model MarketIndicator {
  id        String          @id @default(cuid())
  group     String
  label     String
  value     String
  trend     String
  extraText String?
  dateLabel String
  order     Int             @default(0)
  updatedAt DateTime        @updatedAt
  history   MarketHistory[]
}

model MarketHistory {
  id          String          @id @default(cuid())
  indicatorId String
  value       Float
  date        DateTime        @default(now())
  indicator   MarketIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@index([indicatorId, date])
}

model EconomicalIndicator {
  id        String   @id @default(cuid())
  country   String
  category  String
  value     String
  unit      String?
  year      Int
  trend     String?
  source    String?
  updatedAt DateTime @updatedAt
}

model Activity {
  id        String   @id @default(cuid())
  title     String
  date      String
  location  String
  imageUrl  String?  @db.VarChar(2000)
  link      String?  @db.VarChar(2000)
  createdAt DateTime @default(now())
}

model Tag {
  id          String          @id @default(cuid())
  wpId        Int?            @unique
  name        String
  slug        String          @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  subscribers TagSubscriber[]
  articles    Article[]       @relation("ArticleToTag")
}

model FlashNews {
  id        String   @id @default(cuid())
  time      String
  content   String   @db.Text
  link      String?  @db.VarChar(2000)
  source    String?
  region    String?
  createdAt DateTime @default(now())
}

model JobOffer {
  id          String   @id @default(cuid())
  title       String
  company     String?
  location    String?
  description String?  @db.Text
  url         String?  @db.VarChar(2000)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Visitor {
  id          String   @id @default(cuid())
  ipHash      String
  country     String?
  city        String?
  browser     String?
  os          String?
  device      String?
  brand       String?
  isBot       Boolean  @default(false)
  botName     String?
  botCategory String?
  path        String?  @db.VarChar(2000)
  source      String?
  referrer    String?  @db.VarChar(2000)
  visitedAt   DateTime @default(now())

  @@index([ipHash])
  @@index([isBot])
  @@index([source])
}

model Advertisement {
  id          String    @id @default(cuid())
  title       String
  company     String
  imageUrl    String    @db.VarChar(2000)
  linkUrl     String?   @db.VarChar(2000)
  slot        String
  status      String    @default("PENDING")
  startDate   DateTime?
  endDate     DateTime?
  clicks      Int       @default(0)
  impressions Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  events      AdEvent[]
}

model AdEvent {
  id        String        @id @default(cuid())
  adId      String
  type      String
  path      String?       @db.VarChar(2000)
  ipHash    String?
  userAgent String?       @db.VarChar(1000)
  createdAt DateTime      @default(now())
  ad        Advertisement @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@index([type])
  @@index([createdAt])
}

model WeatherReport {
  id                  String   @id @default(cuid())
  city                String   @default("Abidjan")
  temperature         Int
  condition           String
  icon                String?
  date                DateTime @default(now())
  updatedAt           DateTime @updatedAt
  forecast1Day        String?
  forecast1Icon       String?
  forecast1Temp       Int?
  forecast2Day        String?
  forecast2Icon       String?
  forecast2Temp       Int?
  forecast3Day        String?
  forecast3Icon       String?
  forecast3Temp       Int?
  apparentTemperature Int?
}

model AdInquiry {
  id        String   @id @default(cuid())
  company   String
  name      String
  email     String
  phone     String?
  format    String?
  message   String?  @db.Text
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReadingHistory {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  readAt    DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId], map: "ReadingHistory_articleId_fkey")
}

model ArticleLike {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId], map: "ArticleLike_articleId_fkey")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId], map: "Bookmark_articleId_fkey")
}

model GiftLink {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  articleId String
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([articleId], map: "GiftLink_articleId_fkey")
  @@index([userId], map: "GiftLink_userId_fkey")
}

model FootballMatch {
  id        String   @id @default(cuid())
  team1     String
  team2     String
  team1Flag String?
  team2Flag String?
  matchDate DateTime
  phase     String?
  score     String?
  status    String   @default("UPCOMING")
  matchTime String?
  sport     String   @default("Football")
  sportIcon String?  @default("⚽")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BreakingNews {
  id        String   @id @default(cuid())
  content   String   @db.Text
  link      String?  @db.VarChar(2000)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Caricature {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Titrologie {
  id            String   @id @default(cuid())
  newspaperName String
  imageUrl      String   @db.VarChar(2000)
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
}

model SiteSettings {
  id                  String   @id @default("global")
  facebookUrl         String?  @db.VarChar(500)
  updatedAt           DateTime @updatedAt
  instagramUrl        String?  @db.VarChar(500)
  linkedinUrl         String?  @db.VarChar(500)
  twitterUrl          String?  @db.VarChar(500)
  youtubeUrl          String?  @db.VarChar(500)
  facebookAccessToken String?  @db.Text
  facebookPageId      String?
  linkedinAccessToken String?  @db.Text
  linkedinUrn         String?
  twitterAccessSecret String?  @db.Text
  twitterAccessToken  String?  @db.Text
  twitterApiKey       String?
  twitterApiSecret    String?  @db.Text
  footerCode          String?  @db.LongText
  headerCode          String?  @db.LongText
  siteSkinBlur        Int?     @default(0)
  siteSkinBrightness  Int?     @default(100)
  siteSkinAttachment  String?  @default("fixed")
}

model Quote {
  id        String   @id @default(cuid())
  text      String   @db.Text
  author    String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  userId    String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model AuthorSubscriber {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  authorId  String
  createdAt DateTime @default(now())
  author    Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  user      User?    @relation("UserAuthorSubs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([email, authorId])
  @@index([authorId], map: "AuthorSubscriber_authorId_fkey")
  @@index([userId], map: "AuthorSubscriber_userId_fkey")
}

model DigitalNewspaper {
  id            String     @id @default(cuid())
  title         String
  description   String?    @db.Text
  issueNumber   Int?
  price         Float
  coverImageUrl String?    @db.VarChar(2000)
  pdfUrl        String     @db.VarChar(2000)
  publishedAt   DateTime   @default(now())
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  purchases     Purchase[]
}

model Purchase {
  id                 String           @id @default(cuid())
  userId             String?
  customerEmail      String
  customerName       String?
  digitalNewspaperId String
  companyId          String?
  amount             Float
  status             String           @default("PENDING")
  paymentMethod      String?
  transactionId      String?          @unique
  downloadToken      String           @unique @default(cuid())
  downloadCount      Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  company            Company?         @relation(fields: [companyId], references: [id])
  digitalNewspaper   DigitalNewspaper @relation(fields: [digitalNewspaperId], references: [id], onDelete: NoAction)
  user               User?            @relation(fields: [userId], references: [id])

  @@index([companyId], map: "Purchase_companyId_fkey")
  @@index([digitalNewspaperId], map: "Purchase_digitalNewspaperId_fkey")
  @@index([userId], map: "Purchase_userId_fkey")
}

model ArticleView {
  id        String   @id @default(cuid())
  articleId String
  viewedAt  DateTime @default(now())
  ipHash    String?
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, viewedAt])
  @@index([ipHash])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique @db.VarChar(1000)
  p256dh    String   @db.VarChar(500)
  auth      String   @db.VarChar(500)
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "PushSubscription_userId_fkey")
}

model Company {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  logoUrl   String?    @db.VarChar(2000)
  plan      String     @default("B2B_STANDARD")
  maxUsers  Int        @default(10)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]
  users     User[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  userEmail String?
  action    String
  resource  String?
  details   String?  @db.Text
  ipAddress String?
  userAgent String?  @db.VarChar(1000)
  browser   String?
  device    String?
  os        String?
  city      String?
  country   String?
  createdAt DateTime @default(now())
}

model LiveStream {
  id        String   @id @default(cuid())
  title     String   @default("Direct LDI")
  url       String   @db.VarChar(2000)
  platform  String   @default("OTHER")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  articleId String
  userId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([userId])
}

model SearchEvent {
  id              String   @id @default(cuid())
  query           String
  ipHash          String
  clickedPosition Int?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([query])
}

model GoogleSearchStat {
  id          String   @id @default(cuid())
  date        DateTime
  query       String
  clicks      Int
  impressions Int
  position    Float
  ctr         Float
  createdAt   DateTime @default(now())

  @@unique([date, query])
}

model NewsletterLog {
  id             String   @id @default(cuid())
  campaignType   String
  subject        String
  recipientCount Int
  status         String
  errorMessage   String?  @db.Text
  sentAt         DateTime @default(now())
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  text      String   @db.Text
  context   String?  @db.Text
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, articleId])
  @@index([articleId], map: "Highlight_articleId_fkey")
}

model TagSubscriber {
  id        String   @id @default(cuid())
  userId    String
  tagId     String
  createdAt DateTime @default(now())
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
  @@index([tagId], map: "TagSubscriber_tagId_fkey")
}

model ArticleQuiz {
  id        String         @id @default(cuid())
  articleId String         @unique
  createdAt DateTime       @default(now())
  article   Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  attempts  QuizAttempt[]
  questions QuizQuestion[]
}

model QuizAttempt {
  id        String      @id @default(cuid())
  userId    String
  quizId    String
  score     Int
  createdAt DateTime    @default(now())
  quiz      ArticleQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}

model QuizQuestion {
  id       String      @id @default(cuid())
  quizId   String
  question String      @db.Text
  options  String      @db.Text
  answer   Int
  quiz     ArticleQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId], map: "QuizQuestion_quizId_fkey")
}

model Debate {
  id        String           @id @default(cuid())
  articleId String           @unique
  question  String           @db.Text
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  article   Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  arguments DebateArgument[]
}

model DebateArgument {
  id            String         @id @default(cuid())
  debateId      String
  userId        String
  content       String         @db.Text
  type          String
  votes         Int            @default(0)
  createdAt     DateTime       @default(now())
  argumentVotes ArgumentVote[]
  debate        Debate         @relation(fields: [debateId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([debateId], map: "DebateArgument_debateId_fkey")
  @@index([userId], map: "DebateArgument_userId_fkey")
}

model ArgumentVote {
  id         String         @id @default(cuid())
  argumentId String
  userId     String
  createdAt  DateTime       @default(now())
  argument   DebateArgument @relation(fields: [argumentId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([argumentId, userId])
  @@index([userId], map: "ArgumentVote_userId_fkey")
}

model LiveUpdate {
  id         String   @id @default(cuid())
  articleId  String
  content    String   @db.Text
  authorName String   @default("La Rédaction")
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt(sort: Desc)])
}

model ArticlePurchase {
  id            String   @id @default(cuid())
  userId        String
  articleId     String
  amount        Float
  status        String   @default("PENDING")
  transactionId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}
